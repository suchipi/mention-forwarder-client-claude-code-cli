{
  "$schema": "./mention-forwarder-claude-code.config.schema.json",
  "binary": "claude",
  "cwd": ".",
  "model": "opus",
  "effort": "high",
  "permissionMode": "acceptEdits",
  "approval": "ask",
  "appendSystemPrompt": "Before you change anything, make a git worktree and a branch named after the thread, and do the work there.",
  "allowedTools": "Read Grep Bash(git *)",
  "disallowedTools": "Bash(rm *)",
  "addDirs": [],
  "claudeArgs": [],
  "progress": "all",
  "askTimeoutSeconds": 0,
  "webPort": 4100,
  "stateFile": "./sessions.json",
  "patternsFile": "./patterns.example.mjs",
  "recordFile": "./events.jsonl",
  "logLevel": "info"
}
