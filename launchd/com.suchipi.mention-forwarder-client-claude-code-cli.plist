<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.suchipi.mention-forwarder-client-claude-code-cli</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/absolute/path/to/mention-forwarder-client-claude-code-cli/run.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/absolute/path/to/mention-forwarder-client-claude-code-cli</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/absolute/path/to/the/node/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/absolute/path/to/mention-forwarder-client-claude-code-cli/.tmp/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/absolute/path/to/mention-forwarder-client-claude-code-cli/.tmp/launchd.log</string>
</dict>
</plist>
